# Algolia credentials, from the Algolia dashboard under Settings > API keys.
#
# On Vercel these are injected by the Algolia integration, under its own names --
# vite.config.ts maps whichever shape it uses onto the VITE_ names the app reads.
# Locally, run `vercel env pull .env.local` or fill this in by hand.

# Your Algolia application ID.
VITE_ALGOLIA_APPLICATION_ID=

# Search-only API key. VITE_-prefixed variables are inlined into the client bundle and
# are publicly visible, so this must be a search-only key -- never an admin key.
VITE_ALGOLIA_SEARCH_API_KEY=

# Optional. The connector's destination index. Defaults to `quickstart-products`,
# so leave it blank unless you named your index something else.
VITE_ALGOLIA_INDEX_NAME=

# Write-enabled key, used only by `npm run index:products` to seed an index locally
# without the connector. Deliberately NOT VITE_-prefixed, so it can never reach the
# browser. Do not add it to Vercel -- the frontend never needs it.
ALGOLIA_WRITE_API_KEY=
